// ============================================================================
//  settings.slint — 移动端设置页
//  外观（深色模式 / 主题色）/ 播放（音质 / 音源）/ 语言 / 存储；
//  全部状态由 AppWindow 属性驱动，修改通过 callbacks 交给 Rust 持久化并即时应用。
//  窄屏与平板均为单列，内容最大宽度 640px 居中。
// ============================================================================
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../shared/theme.slint";
import { MobileTheme } from "../theme.slint";

// 分组标题
component GroupTitle inherits Text {
    color: MobileTheme.text-secondary;
    font-size: 12px;
    font-weight: 600;
}

// 分组卡片：液态玻璃圆角卡，内部间距与内边距由使用处的布局提供
component GroupCard inherits Rectangle {
    border-radius: 16px;
    background: transparent;

    // 液态玻璃底：页面内卡片用更通透的 surface-bg（氛围渐层可透出），
    // 与底栏/迷你条的防叠字高不透填充区分
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 16px;
        background: MobileTheme.surface-bg;
        border-width: 1px;
        border-color: MobileTheme.glass-stroke;
        backdrop-blur: MobileTheme.surface-blur-radius;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: MobileTheme.glass-shade;
        clip: true;

        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 1px;
            background: @linear-gradient(90deg,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 0%,
                MobileTheme.glass-shine 12%,
                MobileTheme.glass-shine 88%,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 100%);
        }
    }
}

// 选项 chip：视觉高 36px / 圆角 18px，命中区补足到 44px（触控目标下限）
component Chip inherits Rectangle {
    in property <string> text: "";
    in property <bool> selected: false;
    callback clicked();

    height: 44px;
    background: transparent;

    Rectangle {
        y: 4px;
        width: 100%;
        height: 36px;
        border-radius: 18px;
        border-width: root.selected ? 1px : 0px;
        border-color: MobileTheme.glass-stroke;
        background: root.selected
            ? MobileTheme.glass-capsule
            : (chip-ta.has-hover ? rgba(255, 255, 255, 0.14) : MobileTheme.hover);

        Text {
            width: 100%;
            height: 100%;
            text: root.text;
            color: root.selected ? MobileTheme.text : MobileTheme.text-secondary;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    chip-ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> dark: false;
    in property <int> language: 0;
    in property <int> quality: 0;
    in property <int> source: 0;
    in property <string> cache-usage: "";
    in property <string> data-dir: "";

    callback dark-changed(bool);
    callback language-changed(int);
    callback quality-changed(int);
    callback source-changed(int);
    callback clear-cache();

    background: transparent;

    ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;

        VerticalLayout {
            width: 100%;
            spacing: 16px;
            // 平板内容区顶部/右侧安全区由 AppWindow 容器补足，避免重复叠加
            padding-top: (MobileTheme.layout-kind == 2 ? 0px : MobileTheme.safe-top) + 12px;
            padding-bottom: MobileTheme.safe-bottom + (MobileTheme.layout-kind == 0 ? 176px : 28px);
            padding-left: (MobileTheme.layout-kind == 0 ? MobileTheme.safe-left : 0px)
                + max(16px, (root.width - 640px) / 2);
            padding-right: (MobileTheme.layout-kind == 2 ? 0px : MobileTheme.safe-right)
                + max(16px, (root.width - 640px) / 2);

            Text {
                text: "设置";
                color: MobileTheme.text;
                font-size: 22px;
                font-weight: 700;
            }

            // ===== 外观 =====
            GroupTitle { text: "外观"; }
            GroupCard {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    // 深色模式开关（整行可点）
                    Rectangle {
                        height: 44px;
                        background: transparent;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;

                            Text {
                                text: "深色模式";
                                horizontal-stretch: 1;
                                color: MobileTheme.text;
                                font-size: 14px;
                                vertical-alignment: center;
                            }

                            // 自绘胶囊开关：高 44px，圆点 36px（左右 inset 4px）
                            Rectangle {
                                width: 74px;
                                height: 44px;
                                border-radius: 22px;
                                background: root.dark ? MobileTheme.primary : MobileTheme.active;

                                Rectangle {
                                    y: 4px;
                                    x: root.dark ? parent.width - 40px : 4px;
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: #ffffff;

                                    animate x { duration: 150ms; easing: ease-in-out; }
                                }
                            }
                        }

                        dark-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.dark-changed(!root.dark); }
                        }
                    }
                }
            }

            // ===== 播放 =====
            GroupTitle { text: "播放"; }
            GroupCard {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Text {
                        text: "音质";
                        color: MobileTheme.text-secondary;
                        font-size: 12px;
                    }

                    HorizontalLayout {
                        height: 44px;
                        spacing: 8px;

                        for name[idx] in ["标准", "高音质", "无损"] : Chip {
                            horizontal-stretch: 1;
                            text: name;
                            selected: idx == root.quality;
                            clicked => { root.quality-changed(idx); }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: MobileTheme.divider;
                    }

                    Text {
                        text: "音源";
                        color: MobileTheme.text-secondary;
                        font-size: 12px;
                    }

                    HorizontalLayout {
                        height: 44px;
                        spacing: 6px;

                        for name[idx] in ["网易云", "QQ音乐", "酷狗", "酷我", "咪咕"] : Chip {
                            horizontal-stretch: 1;
                            text: name;
                            selected: idx == root.source;
                            clicked => { root.source-changed(idx); }
                        }
                    }
                }
            }

            // ===== 语言 =====
            GroupTitle { text: "语言"; }
            GroupCard {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 44px;
                        spacing: 8px;

                        Chip {
                            horizontal-stretch: 1;
                            text: "中文";
                            selected: root.language == 0;
                            clicked => { root.language-changed(0); }
                        }
                        Chip {
                            horizontal-stretch: 1;
                            text: "English";
                            selected: root.language == 1;
                            clicked => { root.language-changed(1); }
                        }
                    }

                    Text {
                        text: "移动端界面语言暂固定为中文";
                        color: MobileTheme.text-faint;
                        font-size: 11px;
                    }
                }
            }

            // ===== 存储 =====
            GroupTitle { text: "存储"; }
            GroupCard {
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    HorizontalLayout {
                        height: 44px;

                        Text {
                            text: "缓存占用";
                            horizontal-stretch: 1;
                            color: MobileTheme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.cache-usage;
                            color: MobileTheme.text-secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 44px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: MobileTheme.glass-stroke;
                        background: clear-ta.has-hover ? rgba(255, 255, 255, 0.20) : MobileTheme.glass-capsule;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "清空缓存";
                            color: MobileTheme.text;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        clear-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.clear-cache(); }
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;

                        Text {
                            text: "数据目录";
                            color: MobileTheme.text-faint;
                            font-size: 11px;
                        }
                        Text {
                            text: root.data-dir;
                            color: MobileTheme.text-secondary;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
