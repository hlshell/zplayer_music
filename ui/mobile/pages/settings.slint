// ============================================================================
//  settings.slint — 移动端设置页
//  外观（深色模式 / 主题色）/ 播放（音质 / 音源）/ 语言 / 存储；
//  全部状态由 AppWindow 属性驱动，修改通过 callbacks 交给 Rust 持久化并即时应用。
//  窄屏与平板均为单列，内容最大宽度 640px 居中。
// ============================================================================
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../theme.slint";
import { MobileTheme } from "../theme.slint";

// 分组标题
component GroupTitle inherits Text {
    color: MobileTheme.text-secondary;
    font-size: 12px;
    font-weight: 600;
}

// 分组卡片：圆角 16px 的 surface，内部间距与内边距由使用处的布局提供
component GroupCard inherits Rectangle {
    border-radius: 16px;
    background: MobileTheme.surface;
}

// 选项 chip：视觉高 36px / 圆角 18px，命中区补足到 44px（触控目标下限）
component Chip inherits Rectangle {
    in property <string> text: "";
    in property <bool> selected: false;
    callback clicked();

    height: 44px;
    background: transparent;

    Rectangle {
        y: 4px;
        width: 100%;
        height: 36px;
        border-radius: 18px;
        background: root.selected
            ? MobileTheme.primary
            : (chip-ta.has-hover ? MobileTheme.active : MobileTheme.hover);

        Text {
            width: 100%;
            height: 100%;
            text: root.text;
            color: root.selected ? Theme.palette.icon-white : MobileTheme.text-secondary;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    chip-ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsPage inherits Rectangle {
    in property <bool> dark: false;
    in property <int> theme-color: 0;
    in property <int> language: 0;
    in property <int> quality: 0;
    in property <int> source: 0;
    in property <string> cache-usage: "";
    in property <string> data-dir: "";

    callback dark-changed(bool);
    callback theme-changed(int);
    callback language-changed(int);
    callback quality-changed(int);
    callback source-changed(int);
    callback clear-cache();

    background: transparent;

    ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;

        VerticalLayout {
            width: 100%;
            spacing: 16px;
            // 平板内容区顶部/右侧安全区由 AppWindow 容器补足，避免重复叠加
            padding-top: (MobileTheme.layout-kind == 2 ? 0px : MobileTheme.safe-top) + 12px;
            padding-bottom: MobileTheme.safe-bottom + 28px;
            padding-left: (MobileTheme.layout-kind == 0 ? MobileTheme.safe-left : 0px)
                + max(16px, (root.width - 640px) / 2);
            padding-right: (MobileTheme.layout-kind == 2 ? 0px : MobileTheme.safe-right)
                + max(16px, (root.width - 640px) / 2);

            Text {
                text: "设置";
                color: MobileTheme.text;
                font-size: 22px;
                font-weight: 700;
            }

            // ===== 外观 =====
            GroupTitle { text: "外观"; }
            GroupCard {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    // 深色模式开关（整行可点）
                    Rectangle {
                        height: 44px;
                        background: transparent;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;

                            Text {
                                text: "深色模式";
                                horizontal-stretch: 1;
                                color: MobileTheme.text;
                                font-size: 14px;
                                vertical-alignment: center;
                            }

                            // 自绘胶囊开关：高 44px，圆点 36px（左右 inset 4px）
                            Rectangle {
                                width: 74px;
                                height: 44px;
                                border-radius: 22px;
                                background: root.dark ? MobileTheme.primary : MobileTheme.active;

                                Rectangle {
                                    y: 4px;
                                    x: root.dark ? parent.width - 40px : 4px;
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: #ffffff;

                                    animate x { duration: 150ms; easing: ease-in-out; }
                                }
                            }
                        }

                        dark-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.dark-changed(!root.dark); }
                        }
                    }

                    // 主题色：4 个 40px 圆形色块（选中加白色描边）
                    Rectangle {
                        height: 44px;
                        background: transparent;

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            spacing: 10px;

                            Text {
                                text: "主题色";
                                horizontal-stretch: 1;
                                color: MobileTheme.text;
                                font-size: 14px;
                                vertical-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: 4px;

                                for c[idx] in [#6c5ce7, #0ea371, #ea580c, #3b82f6] : Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    background: transparent;

                                    Rectangle {
                                        x: 2px;
                                        y: 2px;
                                        width: 40px;
                                        height: 40px;
                                        border-radius: 20px;
                                        background: c;
                                        border-width: idx == root.theme-color ? 2px : 0px;
                                        border-color: Theme.palette.icon-white;
                                    }

                                    TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: pointer;
                                        clicked => { root.theme-changed(idx); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ===== 播放 =====
            GroupTitle { text: "播放"; }
            GroupCard {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Text {
                        text: "音质";
                        color: MobileTheme.text-secondary;
                        font-size: 12px;
                    }

                    HorizontalLayout {
                        height: 44px;
                        spacing: 8px;

                        for name[idx] in ["标准", "高音质", "无损"] : Chip {
                            horizontal-stretch: 1;
                            text: name;
                            selected: idx == root.quality;
                            clicked => { root.quality-changed(idx); }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: MobileTheme.divider;
                    }

                    Text {
                        text: "音源";
                        color: MobileTheme.text-secondary;
                        font-size: 12px;
                    }

                    HorizontalLayout {
                        height: 44px;
                        spacing: 6px;

                        for name[idx] in ["网易云", "QQ音乐", "酷狗", "酷我", "咪咕"] : Chip {
                            horizontal-stretch: 1;
                            text: name;
                            selected: idx == root.source;
                            clicked => { root.source-changed(idx); }
                        }
                    }
                }
            }

            // ===== 语言 =====
            GroupTitle { text: "语言"; }
            GroupCard {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 44px;
                        spacing: 8px;

                        Chip {
                            horizontal-stretch: 1;
                            text: "中文";
                            selected: root.language == 0;
                            clicked => { root.language-changed(0); }
                        }
                        Chip {
                            horizontal-stretch: 1;
                            text: "English";
                            selected: root.language == 1;
                            clicked => { root.language-changed(1); }
                        }
                    }

                    Text {
                        text: "移动端界面语言暂固定为中文";
                        color: MobileTheme.text-faint;
                        font-size: 11px;
                    }
                }
            }

            // ===== 存储 =====
            GroupTitle { text: "存储"; }
            GroupCard {
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;

                    HorizontalLayout {
                        height: 44px;

                        Text {
                            text: "缓存占用";
                            horizontal-stretch: 1;
                            color: MobileTheme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.cache-usage;
                            color: MobileTheme.text-secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 44px;
                        border-radius: 12px;
                        background: clear-ta.has-hover ? MobileTheme.active : MobileTheme.hover;

                        Text {
                            width: 100%;
                            height: 100%;
                            text: "清空缓存";
                            color: MobileTheme.primary;
                            font-size: 14px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        clear-ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: pointer;
                            clicked => { root.clear-cache(); }
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;

                        Text {
                            text: "数据目录";
                            color: MobileTheme.text-faint;
                            font-size: 11px;
                        }
                        Text {
                            text: root.data-dir;
                            color: MobileTheme.text-secondary;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
