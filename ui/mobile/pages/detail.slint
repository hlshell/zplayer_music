// ============================================================================
//  detail.slint — 移动端歌单/专辑详情页
//  kind：0=歌单 / 1=专辑 / 3=电台 / 4=每日推荐
//  窄屏：固定顶栏（滚动后切换 compact 显示歌单名+播放icon）+ ScrollView 包裹全部内容；
//  宽屏：头部固定左栏（300px），右侧列表独立滚动。
// ============================================================================
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../../shared/theme.slint";
import { MobileTheme } from "../theme.slint";
import { Song } from "../../shared/models.slint";
import { SongRow } from "../components/song-row.slint";

// 封面：空图回退主题渐变
component DetailCover inherits Rectangle {
    in property <image> cover;

    width: 120px;
    height: 120px;
    border-radius: 16px;
    clip: true;
    background: @linear-gradient(135deg, MobileTheme.primary 0%, MobileTheme.secondary 100%);

    if (root.cover.width > 0) : Image {
        width: 100%;
        height: 100%;
        source: root.cover;
    }
}

// 头部文字块：标题（20px 粗体）+ 描述（2 行 elide）+ 曲目数
component DetailTitle inherits VerticalLayout {
    in property <string> title: "";
    in property <string> desc: "";
    in property <int> count: 0;

    spacing: 6px;

    Text {
        text: root.title == "" ? "加载中…" : root.title;
        color: MobileTheme.text;
        font-size: 20px;
        font-weight: 700;
        overflow: elide;
    }
    if (root.desc != "") : Text {
        text: root.desc;
        color: MobileTheme.text-secondary;
        font-size: 12px;
        wrap: word-wrap;
        max-lines: 2;
        overflow: elide;
    }
    Text {
        text: "共 " + root.count + " 首";
        color: MobileTheme.text-faint;
        font-size: 11px;
    }
}

// 顶栏：48px 返回按钮 + 标题；compact=true 时显示歌单名+播放icon
component DetailTopBar inherits Rectangle {
    in property <int> kind: 0;
    in property <bool> compact: false;
    in property <string> title: "";
    callback back();
    callback play-all();

    height: 48px;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 8px;
        padding-left: (MobileTheme.layout-kind == 0 ? MobileTheme.safe-left : 0px) + 4px;
        padding-right: (MobileTheme.layout-kind == 2 ? 0px : MobileTheme.safe-right) + 4px;
        cross-axis-alignment: center;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: back-ta.has-hover ? MobileTheme.primary.with-alpha(0.18) : MobileTheme.glass-capsule;
            border-width: 1px;
            border-color: MobileTheme.glass-stroke;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                source: @image-url("../../assets/icons/arrow-back-up.svg");
                colorize: MobileTheme.text;
            }
            back-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.back(); }
            }
        }

        // 非 compact：显示类型（歌单/专辑/电台/每日推荐）
        if (!root.compact) : Text {
            text: root.kind == 0 ? "歌单" : root.kind == 3 ? "电台" : root.kind == 4 ? "每日推荐" : "专辑";
            color: MobileTheme.text;
            font-size: 15px;
            font-weight: 600;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }

        // compact：显示歌单名 + 播放全部 icon
        if (root.compact) : Text {
            text: root.title;
            color: MobileTheme.text;
            font-size: 16px;
            font-weight: 700;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }
        if (root.compact) : Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: play-ta.has-hover ? MobileTheme.primary.with-alpha(0.20) : MobileTheme.primary;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                source: @image-url("../../assets/icons/play-white.svg");
            }
            play-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.play-all(); }
            }
        }
    }
}

// 播放全部：视觉高度 40px，触控区域撑到 44px
component DetailPlayAll inherits Rectangle {
    callback clicked();

    height: 44px;
    background: transparent;

    Rectangle {
        y: 2px;
        width: 100%;
        height: 40px;
        border-radius: 20px;
        border-width: 1px;
        border-color: MobileTheme.glass-stroke;
        background: play-ta.has-hover ? rgba(255, 255, 255, 0.24) : MobileTheme.glass-capsule;

        Text {
            width: 100%;
            height: 100%;
            text: "播放全部";
            color: MobileTheme.text;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    play-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DetailPage inherits Rectangle {
    in property <int> kind: 0;
    in property <string> title: "";
    in property <string> desc: "";
    in property <image> cover;
    in property <[Song]> songs;
    in property <bool> loading: false;
    in property <string> error: "";
    in property <bool> wide: false;
    callback back();
    callback song-played(int);
    callback song-more(int);
    callback play-all();

    background: transparent;

    // ===== 宽屏：头部固定左栏，右侧列表独立滚动 =====
    if (root.wide) : HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 16px;

        VerticalLayout {
            width: 300px;
            spacing: 12px;
            padding-top: 4px;

            DetailTopBar {
                kind: root.kind;
                back => { root.back(); }
            }
            DetailCover { cover: root.cover; }
            DetailTitle {
                title: root.title;
                desc: root.desc;
                count: root.songs.length;
            }
            DetailPlayAll {
                clicked => { root.play-all(); }
            }
            Rectangle { vertical-stretch: 1; }
        }

        ScrollView {
            horizontal-stretch: 1;
            height: 100%;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                width: 100%;
                spacing: 4px;
                padding-bottom: MobileTheme.safe-bottom + (MobileTheme.layout-kind == 0 ? 176px : 24px);

                if (root.loading) : Text { text: "加载中…"; color: MobileTheme.text-faint; font-size: 13px; height: 64px; horizontal-alignment: center; vertical-alignment: center; }
                if (!root.loading && root.error != "") : Text { text: root.error; color: MobileTheme.text-secondary; font-size: 13px; height: 64px; horizontal-alignment: center; vertical-alignment: center; }
                if (!root.loading && root.error == "" && root.songs.length == 0) : Text { text: "暂无歌曲"; color: MobileTheme.text-faint; font-size: 13px; height: 64px; horizontal-alignment: center; vertical-alignment: center; }

                if (!root.loading && root.error == "") : VerticalLayout {
                    for s[i] in root.songs : SongRow {
                        index: i;
                        song-id: s.id;
                        rank: "" + (i + 1);
                        title: s.name;
                        subtitle: s.artist;
                        cover: s.cover;
                        from: Theme.palette.primary;
                        to: Theme.palette.secondary;
                        clicked => { root.song-played(s.id); }
                        more(id) => { root.song-more(id); }
                    }
                }
            }
        }
    }

    // ===== 窄屏：固定顶栏 + ScrollView 包裹全部 =====
    if (!root.wide) : VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;
        padding-top: MobileTheme.safe-top + 4px;

        // 固定顶栏：滚动时切换 compact（content-y 为负值，取反）
        DetailTopBar {
            kind: root.kind;
            compact: -sv.content-y > 120px;
            title: root.title;
            back => { root.back(); }
            play-all => { root.play-all(); }
        }

        sv := ScrollView {
            vertical-stretch: 1;
            width: 100%;
            vertical-scrollbar-policy: always-off;
            horizontal-scrollbar-policy: always-off;

            VerticalLayout {
                width: 100%;
                spacing: 8px;
                padding-left: (MobileTheme.layout-kind == 0 ? MobileTheme.safe-left : 0px) + 16px;
                padding-right: (MobileTheme.layout-kind == 2 ? 0px : MobileTheme.safe-right) + 16px;
                padding-bottom: MobileTheme.safe-bottom + (MobileTheme.layout-kind == 0 ? 176px : 24px);

                // 头部：封面 + 标题
                HorizontalLayout {
                    height: 120px;
                    spacing: 14px;
                    padding-left: 0;
                    padding-right: 0;
                    cross-axis-alignment: center;

                    DetailCover { cover: root.cover; }
                    DetailTitle {
                        horizontal-stretch: 1;
                        title: root.title;
                        desc: root.desc;
                        count: root.songs.length;
                    }
                }

                // 播放全部按钮
                DetailPlayAll {
                    clicked => { root.play-all(); }
                }

                // 歌曲列表
                if (root.loading) : Text { text: "加载中…"; color: MobileTheme.text-faint; font-size: 13px; height: 64px; horizontal-alignment: center; vertical-alignment: center; }
                if (!root.loading && root.error != "") : Text { text: root.error; color: MobileTheme.text-secondary; font-size: 13px; height: 64px; horizontal-alignment: center; vertical-alignment: center; }
                if (!root.loading && root.error == "" && root.songs.length == 0) : Text { text: "暂无歌曲"; color: MobileTheme.text-faint; font-size: 13px; height: 64px; horizontal-alignment: center; vertical-alignment: center; }

                if (!root.loading && root.error == "") : VerticalLayout {
                    for s[i] in root.songs : SongRow {
                        index: i;
                        song-id: s.id;
                        rank: "" + (i + 1);
                        title: s.name;
                        subtitle: s.artist;
                        cover: s.cover;
                        from: Theme.palette.primary;
                        to: Theme.palette.secondary;
                        clicked => { root.song-played(s.id); }
                        more(id) => { root.song-more(id); }
                    }
                }
            }
        }
    }
}
