// ============================================================================
//  song-sheet.slint — 歌曲操作底部抽屉（长按 / 三点共用同一入口）
//  遮罩 + 底部玻璃卡片：歌曲信息、播放、下一首播放、收藏切换、可选移除、取消。
//  由 AppWindow 顶层挂载，三种形态与播放层之上均可见。
// ============================================================================
import { Theme } from "../../shared/theme.slint";
import { MobileTheme } from "../theme.slint";

component SheetItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> danger: false;
    callback clicked();

    height: 52px;
    border-radius: 12px;
    background: ta.has-hover ? MobileTheme.hover : transparent;

    Text {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        color: root.danger ? #e03131 : MobileTheme.text;
        font-size: 15px;
        vertical-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SongSheet inherits Rectangle {
    in property <bool> open: false;
    in property <int> sheet-song-id: 0;
    in property <string> title;
    in property <string> artist;
    in property <image> cover;
    in property <bool> liked: false;
    // 空字符串 = 不显示该行（如详情/搜索来源无删除语义）
    in property <string> remove-label: "";

    callback closed();
    callback play(int);
    callback play-next(int);
    callback toggle-like(int);
    callback remove(int);

    // 卡片高度：抓手 20 + 信息 64 + 分隔 1 + 3 项 + 可选移除 1 项 + 取消 52 + 上下留白
    property <length> sheet-h:
        20px + 64px + 1px + 52px * 3
        + (root.remove-label == "" ? 0px : 52px)
        + 52px + 16px + MobileTheme.safe-bottom;

    visible: root.open;
    background: transparent;

    // 遮罩：点击空白关闭
    Rectangle {
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.38);

        mask-ta := TouchArea {
            clicked => { root.closed(); }
        }
    }

    // 底部玻璃卡片：向下多出 24px，令底部圆角落在屏幕外，只显示顶部圆角
    Rectangle {
        y: parent.height - root.sheet-h;
        width: 100%;
        height: root.sheet-h + 24px;
        border-radius: 24px;
        background: MobileTheme.glass-fill;
        backdrop-blur: MobileTheme.glass-blur;
        border-width: 1px;
        border-color: MobileTheme.glass-stroke;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: -4px;
        drop-shadow-color: MobileTheme.glass-shade;
        clip: true;

        // 顶边镜面高光（两端渐隐，避免圆角处硬直线）
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 1px;
            background: @linear-gradient(90deg,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 0%,
                MobileTheme.glass-shine 12%,
                MobileTheme.glass-shine 88%,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 100%);
        }

        // 拦截卡片区域点击，避免穿透到遮罩关闭
        card-ta := TouchArea { }

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0;
            padding-left: 16px;
            padding-right: 16px;

            // 抓手条
            Rectangle {
                height: 20px;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 36px;
                    height: 4px;
                    border-radius: 2px;
                    background: MobileTheme.divider;
                }
            }

            // 歌曲信息
            HorizontalLayout {
                height: 64px;
                spacing: 12px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 10px;
                    clip: true;
                    background: @linear-gradient(135deg, MobileTheme.primary 0%, MobileTheme.secondary 100%);

                    if (root.cover.width > 0) : Image {
                        width: 100%;
                        height: 100%;
                        source: root.cover;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: root.title;
                        color: MobileTheme.text;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: root.artist;
                        color: MobileTheme.text-faint;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
            }

            Rectangle { height: 1px; background: MobileTheme.divider; }

            SheetItem {
                label: "播放";
                clicked => { root.play(root.sheet-song-id); }
            }
            SheetItem {
                label: "下一首播放";
                clicked => { root.play-next(root.sheet-song-id); }
            }
            SheetItem {
                label: root.liked ? "取消收藏" : "收藏";
                clicked => { root.toggle-like(root.sheet-song-id); }
            }
            if (root.remove-label != "") : SheetItem {
                label: root.remove-label;
                danger: true;
                clicked => { root.remove(root.sheet-song-id); }
            }
            SheetItem {
                label: "取消";
                clicked => { root.closed(); }
            }
        }
    }
}
