// ============================================================================
//  mini-player.slint — 手机（竖屏/横屏）迷你播放条，浮在底部导航上方
//  液态玻璃胶囊：半透填充透出极光 + 1px 镜面描边 + 顶边渐隐高光。
//  封面 + 标题/作者 + 上一首 / 播放 / 下一首（玻璃圆钮）+ 顶边细进度条；
//  点击整条打开播放层。
// ============================================================================
import { Theme } from "../../shared/theme.slint";
import { MobileTheme } from "../theme.slint";

// 玻璃圆形图标按钮：半透白底 + 细描边 + 顶边渐隐高光，图标统一白色
component MiniCircleButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 34px;
    in property <length> icon-size: 16px;
    callback clicked;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: btn-ta.has-hover ? Theme.palette.hover : MobileTheme.glass-capsule;
    border-width: 1px;
    border-color: MobileTheme.glass-stroke;
    clip: true;

    // 顶边渐隐高光
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 1px;
        background: @linear-gradient(90deg,
            rgba(255, 255, 255, 0.0) 0%,
            rgba(255, 255, 255, 0.70) 20%,
            rgba(255, 255, 255, 0.70) 80%,
            rgba(255, 255, 255, 0.0) 100%);
    }

    Image {
        source: root.icon;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        colorize: MobileTheme.icon;
    }

    btn-ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MiniPlayer inherits Rectangle {
    in property <string> title: "未在播放";
    in property <string> subtitle: "";
    in-out property <bool> playing: false;
    in property <float> progress: 0.0;
    // 音频加载中：进度条改为往返滑动 + 副标题提示
    in property <bool> loading: false;
    property <float> indet: 0.0;
    callback clicked();
    callback toggled();
    callback prev();
    callback next();

    height: 62px;
    border-radius: 20px;
    background: transparent;

    // 加载中：每帧推进 indeterminate 位置（仅 loading 时运行）
    Timer {
        interval: 16ms;
        running: root.loading;
        triggered => {
            root.indet = Math.mod(root.indet + 0.018, 1.0);
        }
    }

    // 液态玻璃底
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 20px;
        background: MobileTheme.glass-fill;
        border-width: 1px;
        border-color: MobileTheme.glass-stroke;
        backdrop-blur: MobileTheme.glass-blur;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: MobileTheme.glass-shade;
        clip: true;

        // 顶边镜面高光：两端渐隐，避免在圆角处形成一条贯穿的硬直线
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 1px;
            background: @linear-gradient(90deg,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 0%,
                MobileTheme.glass-shine 12%,
                MobileTheme.glass-shine 88%,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 100%);
        }

        // 进度条：贴齐胶囊顶边内侧（随圆角裁剪，不再突出胶囊外）；
        // track 淡黑在透亮的玻璃上可见，fill 为紫青渐变，progress=0 时也能看到轨道。
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 3px;
            background: MobileTheme.glass-track;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * min(1.0, max(0.0, root.progress));
                height: 100%;
                background: @linear-gradient(90deg, MobileTheme.primary 0%, MobileTheme.secondary 100%);
                visible: !root.loading;
            }

            // 加载中：一段 28% 宽的高亮条往返滑动
            if (root.loading) : Rectangle {
                x: (parent.width - self.width) * (1.0 - abs(2.0 * root.indet - 1.0));
                y: 0;
                width: parent.width * 0.28;
                height: 100%;
                background: @linear-gradient(90deg, MobileTheme.primary 0%, MobileTheme.secondary 100%);
            }
        }
    }

    // 整条热区先声明，后声明的按钮热区优先，避免点按钮同时打开播放层
    body-ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 8px;
        padding-left: 10px;
        padding-right: 10px;
        cross-axis-alignment: center;

        // 封面占位（无图片资源，用主题渐变代替）
        Rectangle {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            clip: true;
            background: @linear-gradient(135deg, Theme.palette.primary 0%, Theme.palette.secondary 100%);

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: rgba(255, 255, 255, 0.22);
            }
            // 封面顶边高光
            Rectangle {
                x: 0;
                y: 0;
                width: 100%;
                height: 1px;
                background: rgba(255, 255, 255, 0.55);
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.title;
                color: MobileTheme.text;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.loading ? "正在加载…" : root.subtitle;
                color: root.loading ? MobileTheme.primary : MobileTheme.text-secondary;
                font-size: 11px;
                font-weight: root.loading ? 600 : 400;
                overflow: elide;
            }
        }

        // 上一首 / 播放 / 下一首：播放为主操作（主题渐变），上下首为玻璃圆钮
        MiniCircleButton {
            icon: @image-url("../../assets/icons/prev-gray.svg");
            clicked => { root.prev(); }
        }

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: @linear-gradient(140deg, Theme.palette.primary 0%, Theme.palette.secondary 100%);
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: rgba(Theme.palette.primary.red, Theme.palette.primary.green, Theme.palette.primary.blue, 0.35);

            Image {
                source: root.playing
                    ? @image-url("../../assets/icons/pause-white.svg")
                    : @image-url("../../assets/icons/play-white.svg");
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                colorize: Theme.palette.icon-white;
            }

            play-ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.toggled(); }
            }
        }

        MiniCircleButton {
            icon: @image-url("../../assets/icons/next-gray.svg");
            clicked => { root.next(); }
        }
    }

}
