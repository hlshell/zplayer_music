// ============================================================================
//  nav.slint — 一级导航的三种呈现，共用同一份「当前项」状态
//  NavBottomBar：手机竖屏三栏底部导航（高度含安全区底部）
//  NavRail：手机横屏左侧 72px 窄栏（图标 + 小字，对应 spec §4）
//  NavSidebar：平板左侧 224px 完整侧栏（图标 + 文字）
//  三项固定为 首页 / 搜索 / 设置，点击回调 selected(idx)。
// ============================================================================
import { Theme } from "../../shared/theme.slint";
import { MobileTheme } from "../theme.slint";

component NavCell inherits Rectangle {
    in property <image> icon;
    in property <string> label: "";
    in property <bool> active: false;
    // true = 图标与文字横排（平板侧栏）；false = 图标在上文字在下（底部导航/窄栏）
    in property <bool> horizontal: false;
    in property <length> label-size: 12px;
    callback clicked;

    // 选中用主色、未选中用次要文字色：浅色/深色下均清晰可读，靠玻璃胶囊区分选中态
    in property <color> fg: root.active ? MobileTheme.primary : MobileTheme.text-secondary;

    min-width: MobileTheme.touch-target;
    min-height: MobileTheme.touch-target;
    border-radius: root.horizontal ? 12px : 26px;
    // 选中统一用玻璃胶囊：半透白填充 + 细描边，不再用主题色染图标
    border-width: root.active ? 1px : 0px;
    border-color: MobileTheme.glass-stroke;
    background: root.active
        ? MobileTheme.glass-capsule
        : (ta.has-hover ? Theme.palette.hover : transparent);

    if (root.horizontal) : HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 12px;
        padding-left: 14px;
        padding-right: 12px;
        cross-axis-alignment: center;

        Image {
            source: root.icon;
            width: 20px;
            height: 20px;
            colorize: root.fg;
        }
        Text {
            text: root.label;
            color: root.fg;
            font-size: root.label-size;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if (!root.horizontal) : VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 3px;
        alignment: center;

        // 图标单独包一层并显式水平居中，避免布局交叉轴默认起点对齐导致图标偏左
        Rectangle {
            height: 24px;
            background: transparent;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                source: root.icon;
                colorize: root.fg;
            }
        }
        Text {
            text: root.label;
            color: root.fg;
            font-size: root.label-size;
            font-weight: root.active ? 600 : 400;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    // 选中指示条：仅侧栏保留左侧竖条；底部导航不画横条
    if (root.active && root.horizontal) : Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 22px;
        border-radius: 1.5px;
        background: MobileTheme.primary;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component NavBottomBar inherits Rectangle {
    in-out property <int> current: 0;
    in property <[string]> labels: ["首页", "搜索", "最近", "设置"];
    callback selected(int);

    // 浮层胶囊：由 AppWindow 绝对定位（左右 14px / 高 62px / 底部让出安全区）
    height: 62px;
    background: transparent;

    // 液态玻璃底：极低白度渐变 + 1px 镜面描边 + 顶边高光 + 底部反光 + 外投影
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 31px;
        background: MobileTheme.glass-fill;
        border-width: 1px;
        border-color: MobileTheme.glass-stroke;
        backdrop-blur: MobileTheme.glass-blur;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: MobileTheme.glass-shade;
        clip: true;

        // 顶边镜面高光：两端渐隐，避免在圆角处形成一条贯穿的硬直线
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 1px;
            background: @linear-gradient(90deg,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 0%,
                MobileTheme.glass-shine 12%,
                MobileTheme.glass-shine 88%,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 100%);
        }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 2px;
        padding: 6px;

        NavCell {
            icon: @image-url("../../assets/icons/home-gray.svg");
            label: root.labels[0];
            active: root.current == 0;
            label-size: 10px;
            horizontal-stretch: 1;
            clicked => { root.current = 0; root.selected(0); }
        }
        NavCell {
            icon: @image-url("../../assets/icons/search-gray.svg");
            label: root.labels[1];
            active: root.current == 1;
            label-size: 10px;
            horizontal-stretch: 1;
            clicked => { root.current = 1; root.selected(1); }
        }
        NavCell {
            icon: @image-url("../../assets/icons/recent-gray.svg");
            label: root.labels[2];
            active: root.current == 2;
            label-size: 10px;
            horizontal-stretch: 1;
            clicked => { root.current = 2; root.selected(2); }
        }
        NavCell {
            icon: @image-url("../../assets/icons/settings-gray.svg");
            label: root.labels[3];
            active: root.current == 3;
            label-size: 10px;
            horizontal-stretch: 1;
            clicked => { root.current = 3; root.selected(3); }
        }
    }
}

export component NavRail inherits Rectangle {
    in-out property <int> current: 0;
    in property <[string]> labels: ["首页", "搜索", "最近", "设置"];
    callback selected(int);

    width: MobileTheme.rail-width + MobileTheme.safe-left;
    height: 100%;
    background: transparent;

    // 液态玻璃：整条 rail 右侧渐变变暗，视觉上"沉"进内容区
    Rectangle {
        width: 100%;
        height: 100%;
        background: MobileTheme.glass-fill;
        backdrop-blur: MobileTheme.glass-blur;
        clip: true;

        // 右侧 1px 镜面描边
        Rectangle {
            x: parent.width - 1px;
            y: 0;
            width: 1px;
            height: 100%;
            background: MobileTheme.glass-stroke;
        }
        // 顶边高光：两端渐隐，避免贯穿硬直线
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 1px;
            background: @linear-gradient(90deg,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 0%,
                MobileTheme.glass-shine 12%,
                MobileTheme.glass-shine 88%,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 100%);
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 8px;
        padding-top: MobileTheme.safe-top + 12px;
        padding-bottom: MobileTheme.safe-bottom + 12px;
        padding-left: MobileTheme.safe-left + 6px;
        padding-right: 6px;

        NavCell {
            height: 64px;
            icon: @image-url("../../assets/icons/home-gray.svg");
            label: root.labels[0];
            active: root.current == 0;
            label-size: 10px;
            clicked => { root.current = 0; root.selected(0); }
        }
        NavCell {
            height: 64px;
            icon: @image-url("../../assets/icons/search-gray.svg");
            label: root.labels[1];
            active: root.current == 1;
            label-size: 10px;
            clicked => { root.current = 1; root.selected(1); }
        }
        NavCell {
            height: 64px;
            icon: @image-url("../../assets/icons/recent-gray.svg");
            label: root.labels[2];
            active: root.current == 2;
            label-size: 10px;
            clicked => { root.current = 2; root.selected(2); }
        }
        NavCell {
            height: 64px;
            icon: @image-url("../../assets/icons/settings-gray.svg");
            label: root.labels[3];
            active: root.current == 3;
            label-size: 10px;
            clicked => { root.current = 3; root.selected(3); }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

export component NavSidebar inherits Rectangle {
    in-out property <int> current: 0;
    in property <[string]> labels: ["首页", "搜索", "最近", "设置"];
    callback selected(int);

    width: MobileTheme.sidebar-width + MobileTheme.safe-left;
    height: 100%;
    background: transparent;

    // 液态玻璃：sidebar 从左到右透明度过渡，右侧沉进内容区
    Rectangle {
        width: 100%;
        height: 100%;
        background: MobileTheme.glass-fill;
        backdrop-blur: MobileTheme.glass-blur;
        clip: true;

        // 右侧 1px 镜面描边
        Rectangle {
            x: parent.width - 1px;
            y: 0;
            width: 1px;
            height: 100%;
            background: MobileTheme.glass-stroke;
        }
        // 顶边高光：两端渐隐，避免贯穿硬直线
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 1px;
            background: @linear-gradient(90deg,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 0%,
                MobileTheme.glass-shine 12%,
                MobileTheme.glass-shine 88%,
                rgba(MobileTheme.glass-shine.red, MobileTheme.glass-shine.green, MobileTheme.glass-shine.blue, 0.0) 100%);
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 6px;
        padding-top: MobileTheme.safe-top + 20px;
        padding-bottom: MobileTheme.safe-bottom + 16px;
        padding-left: MobileTheme.safe-left + 12px;
        padding-right: 12px;

        // 品牌头
        HorizontalLayout {
            height: 48px;
            spacing: 10px;
            padding-left: 6px;
            padding-right: 6px;
            cross-axis-alignment: center;

            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 12px;
                background: @linear-gradient(135deg, MobileTheme.primary 0%, MobileTheme.secondary 100%);
                Text {
                    text: "Z";
                    color: Theme.palette.icon-white;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "ZPlayer Music";
                color: MobileTheme.text;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle { height: 1px; background: MobileTheme.divider; }

        NavCell {
            height: MobileTheme.touch-target;
            horizontal: true;
            label-size: 14px;
            icon: @image-url("../../assets/icons/home-gray.svg");
            label: root.labels[0];
            active: root.current == 0;
            clicked => { root.current = 0; root.selected(0); }
        }
        NavCell {
            height: MobileTheme.touch-target;
            horizontal: true;
            label-size: 14px;
            icon: @image-url("../../assets/icons/search-gray.svg");
            label: root.labels[1];
            active: root.current == 1;
            clicked => { root.current = 1; root.selected(1); }
        }
        NavCell {
            height: MobileTheme.touch-target;
            horizontal: true;
            label-size: 14px;
            icon: @image-url("../../assets/icons/recent-gray.svg");
            label: root.labels[2];
            active: root.current == 2;
            clicked => { root.current = 2; root.selected(2); }
        }
        NavCell {
            height: MobileTheme.touch-target;
            horizontal: true;
            label-size: 14px;
            icon: @image-url("../../assets/icons/settings-gray.svg");
            label: root.labels[3];
            active: root.current == 3;
            clicked => { root.current = 3; root.selected(3); }
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            height: 16px;
            padding-left: 8px;

            Text {
                text: "移动端预览";
                color: MobileTheme.text-faint;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }
}
