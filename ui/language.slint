    in-out property <string> app-theme-color: "主题色";
    in-out property <string> app-theme-color-desc: "选择界面强调色";
    in-out property <string> app-c-purple: "紫青渐变";
    in-out property <string> app-c-teal: "青绿渐变";
    in-out property <string> app-c-orange: "橙红渐变";
    in-out property <string> app-c-blue: "蓝紫渐变";
    in-out property <string> app-lyrics-layout: "歌词布局";
    in-out property <string> app-lyrics-desc: "选择歌词与封面的排布方式";
    in-out property <string> app-lyrics-cover: "上封面模式";
    in-out property <string> app-lyrics-side: "左右模式";
    in-out property <string> app-close-behavior: "关闭行为";
    in-out property <string> app-close-desc: "关闭窗口时执行的操作";
    in-out property <string> app-close-ask: "每次询问";
    in-out property <string> app-close-tray: "最小化到托盘";
    in-out property <string> app-close-exit: "直接退出";
    // ---- 关闭确认卡片 ----
    in-out property <string> close-title: "关闭应用";
    in-out property <string> close-subtitle: "请选择关闭方式";
    in-out property <string> close-remember: "记住我的选择";
    in-out property <string> close-exit-app: "退出应用";
    in-out property <string> app-shortcut: "快捷键配置";
