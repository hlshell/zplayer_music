// ============================================================================
//  language.slint — 全局语言文案（i18n）
//  类似 Theme global：任何组件直接读 Language.xxx，无需逐层传参。
//  Rust 侧启动/切语言时从内置(ui/assets/lang/XX.json)或用户扩展(二进制/lang/XX.json)
//  加载对应短码，把键值逐项写入本 global 属性。
//  key 命名：模块前缀 + 连字符（如 nav-home / play-quality / sys-cache-limit）。
// ============================================================================

export global Language {
    // ---- 通用 ----
    in-out property <string> common-ok: "确认";
    in-out property <string> common-close: "关闭";
    in-out property <string> common-cancel: "取消";
    in-out property <string> common-check-update: "检查更新";
    in-out property <string> common-current-version: "当前版本";
    in-out property <string> common-author-info: "作者信息";

    // ---- 侧边栏导航 ----
    in-out property <string> nav-home: "首页";
    in-out property <string> nav-search: "搜索";
    in-out property <string> nav-playlists: "歌单";
    in-out property <string> nav-albums: "专辑";
    in-out property <string> nav-mv: "MV";
    in-out property <string> nav-radio: "电台";
    in-out property <string> nav-toplist: "排行榜";
    in-out property <string> nav-liked: "我的最爱";
    in-out property <string> nav-recent: "最近播放";
    in-out property <string> nav-local: "本地资源";
    in-out property <string> nav-settings: "设置";
    in-out property <string> nav-not-logged: "未登录";
    in-out property <string> nav-login-hint: "登录后同步歌单";

    // ---- 设置页 Tab ----
    in-out property <string> tab-basic: "基础设置";
    in-out property <string> tab-play: "播放设置";
    in-out property <string> tab-app: "应用设置";
    in-out property <string> tab-network: "网络设置";
    in-out property <string> tab-system: "系统管理";
    in-out property <string> tab-about: "关于";
    in-out property <string> tab-donate: "捐赠支持";

    // ---- 基础设置 ----
    in-out property <string> base-theme-mode: "主题模式";
    in-out property <string> base-theme-mode-desc: "切换浅色与深色界面主题";
    in-out property <string> base-light: "浅色";
    in-out property <string> base-dark: "深色";
    in-out property <string> base-auto-launch: "开机自启";
    in-out property <string> base-auto-launch-desc: "开机后自动启动 ZPlayer";
    in-out property <string> base-language: "语言设置";
    in-out property <string> base-language-desc: "选择界面显示语言";
    in-out property <string> base-font: "字体设置";
    in-out property <string> base-font-desc: "设置界面字体";
    in-out property <string> base-font-default: "默认";
    in-out property <string> base-font-yahei: "微软雅黑";
    in-out property <string> base-font-sourcehan: "思源黑体";

    // ---- 播放设置 ----
    in-out property <string> play-quality: "音质设置";
    in-out property <string> play-quality-desc: "选择在线播放的音质等级";
    in-out property <string> play-q-standard: "标准 128Kbps";
    in-out property <string> play-q-high: "高音质 320Kbps";
