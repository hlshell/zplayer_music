    in-out property <string> songlist-col-title: "标题";
    in-out property <string> songlist-col-duration: "时长";
    in-out property <string> suggest-kind-song: "单曲";
    in-out property <string> suggest-kind-artist: "歌手";
    in-out property <string> suggest-kind-album: "专辑";
    in-out property <string> suggest-kind-playlist: "歌单";
    in-out property <string> suggest-kind-lyric: "歌词";
    in-out property <string> suggest-kind-radio: "电台";
    in-out property <string> suggest-kind-mixed: "联想";
