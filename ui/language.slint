    in-out property <string> net-buffer-note: "网络缓冲时长暂不适用：当前采用整曲下载后播放";
    in-out property <string> net-proxy: "代理设置";
    in-out property <string> net-proxy-desc: "通过代理服务器访问网络";
    in-out property <string> net-configure: "配置";
    in-out property <string> net-realip: "realip 设置";
    in-out property <string> net-realip-desc: "开启后使用真实 IP 访问";
    in-out property <string> net-realip-placeholder: "realip 地址";
    in-out property <string> net-proxy-addr: "代理地址";
    in-out property <string> net-proxy-port: "端口";
    in-out property <string> net-proxy-host-ph: "例如 127.0.0.1";
    in-out property <string> net-proxy-port-ph: "例如 7890";
