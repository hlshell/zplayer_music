    in-out property <string> sys-cache-dir-desc: "自定义缓存根目录（歌曲/封面/歌词统一存放）";
    in-out property <string> sys-cache-limit: "缓存上限";
    in-out property <string> sys-cache-limit-desc: "缓存占用上限，0 表示不限制";
    in-out property <string> sys-mb: "MB";
    in-out property <string> sys-evict: "缓存清理策略";
    in-out property <string> sys-evict-desc: "空间不足时按此策略优先清理";
    in-out property <string> sys-evict-lru: "最近少用 (LRU)";
    in-out property <string> sys-evict-fifo: "先进先出 (FIFO)";
    in-out property <string> sys-status-title: "缓存状态";
    in-out property <string> sys-manage-title: "缓存管理";
    in-out property <string> sys-clear-music: "清理音乐";
    in-out property <string> sys-clear-lyrics: "清理歌词";
    in-out property <string> sys-clear-covers: "清理封面";
    in-out property <string> sys-clear-all: "全部清理";
    in-out property <string> sys-music-count: "音乐 ";
    in-out property <string> sys-lyric-count: "歌词 ";
