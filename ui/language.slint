    in-out property <string> play-output-device: "音频输出设备";
    in-out property <string> play-output-desc: "选择音频输出设备";
    in-out property <string> play-script-title: "音源脚本";
    in-out property <string> play-import-script: "导入音源脚本";
    in-out property <string> play-import-desc: "导入洛雪 .js 音源脚本（支持多音源聚合，可自定义）";
    in-out property <string> play-select-file: "选择文件";
    in-out property <string> play-check-update-script: "检查更新音源";
    in-out property <string> play-check-update-desc: "从内置维护清单拉取最新音源脚本";
    in-out property <string> play-auto-update-script: "自动更新音源";
