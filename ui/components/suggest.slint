// ============================================================================
//  SearchSuggestPanel —— 搜索预选词弹出面板（贴着搜索胶囊下方，宽度对齐胶囊）
//  数据：items（Rust 侧拉取 allMatch 并截断到 8 条）
//  高亮：键盘选中（selected-index）或鼠标悬停（行内 has-hover）均高亮
//  点击：picked(i) → 填入搜索框并立即搜索（由 AppWindow 处理）
// ============================================================================
import { Theme } from "../theme.slint";
import { Language } from "../language.slint";
import { SuggestItem } from "models.slint";

export component SearchSuggestPanel inherits Rectangle {
    in property <[SuggestItem]> items;
    in property <int> selected-index: -1;
    in property <length> panel-x;
    in property <length> panel-y;
    in property <length> panel-width;
    callback picked(int);

    x: panel-x;
    y: panel-y;
    width: panel-width;
    height: items.length * 34px + 8px;
    border-radius: 12px;
    background: Theme.palette.surface-solid;
    border-width: 1px;
    border-color: Theme.palette.divider-strong;
    drop-shadow-blur: 18px;
    drop-shadow-color: rgba(0, 0, 0, 0.22);
    drop-shadow-offset-y: 6px;

    // 建议行列表（每行 34px；面板上下各留 4px 内边距）
    VerticalLayout {
        x: 0; y: 4px;
        width: 100%;
        height: items.length * 34px;
        spacing: 0;
        for item[i] in items : Rectangle {
            height: 34px;
            width: 100%;
            border-radius: 8px;
            background: i == root.selected-index || row-ta.has-hover
                ? Theme.palette.hover
                : transparent;

            HorizontalLayout {
                x: 2px;
                width: parent.width - 4px;
                height: 100%;
                spacing: 8px;
                padding-left: 10px;
                padding-right: 10px;
                cross-axis-alignment: center;

                // 分类图标：放大镜（选中/悬停时主色）
                Image {
                    source: @image-url("../assets/icons/search-faint.svg");
                    width: 13px; height: 13px;
                    colorize: i == root.selected-index || row-ta.has-hover
                        ? Theme.palette.primary
                        : Theme.palette.icon-faint;
                    vertical-alignment: center;
                }
                // 关键词
                Text {
                    text: item.keyword;
                    font-size: 13px;
                    color: i == root.selected-index || row-ta.has-hover
                        ? Theme.palette.primary
                        : Theme.palette.text;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // 分类标签
                Text {
                    text: item.kind == "song" ? Language.suggest-kind-song
                        : item.kind == "artist" ? Language.suggest-kind-artist
                        : item.kind == "album" ? Language.suggest-kind-album
                        : item.kind == "playlist" ? Language.suggest-kind-playlist
                        : item.kind == "mv" ? Language.nav-mv
                        : item.kind == "lyric" ? Language.suggest-kind-lyric
                        : item.kind == "radio" ? Language.suggest-kind-radio
                        : Language.suggest-kind-mixed;
                    font-size: 10.5px;
                    color: Theme.palette.text-faint;
                    vertical-alignment: center;
                }
            }

            // 行交互：悬停高亮 + 点击选中
            row-ta := TouchArea {
                x: 0; y: 0;
                width: 100%; height: 100%;
                clicked => { root.picked(i); }
                mouse-cursor: pointer;
            }
        }
    }
}
