// ============================================================================
//  pages/placeholder.slint — 通用占位页（已接入主题）
// ============================================================================
import { Theme } from "../../theme.slint";
import { Language } from "../../language.slint";

export component PlaceholderPage inherits VerticalLayout {
    in property <string> icon: "◈";
    in property <string> title: Language.placeholder-title;
    in property <string> desc: Language.placeholder-desc;

    width: 100%;
    height: 380px;
    alignment: center;
    spacing: 12px;

    Text { text: root.icon; color: Theme.palette.text-faint; font-size: 40px; horizontal-alignment: center; }
    Text { text: root.title; color: Theme.palette.text-secondary; font-size: 18px; font-weight: 600; horizontal-alignment: center; }
    Text { text: root.desc; color: Theme.palette.text-faint; font-size: 13px; horizontal-alignment: center; }
}
