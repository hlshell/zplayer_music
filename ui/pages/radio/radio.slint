// ============================================================================
//  pages/radio/radio.slint — 电台页（真实数据：电台分类 + 电台列表）
//  顶部固定：标题（随分类变更）+ 副标题 + 分类 Tab（复用通用 TabBar，悬浮吸顶）
//  下方 ScrollView 滚动电台响应式网格（首页式列数 3~5），触底分页加载。
// ============================================================================
import { MediaCard } from "../../components/media.slint";
import { PlaceholderPage } from "../placeholder/placeholder.slint";
import { Radio } from "../../components/models.slint";
import { Theme } from "../../theme.slint";
import { Language } from "../../language.slint";
import { TabBar } from "../../components/tab-bar.slint";
import { CustomScrollBar } from "../../components/scroll.slint";
import { ScrollView } from "std-widgets.slint";

export component RadioPage inherits Rectangle {
    in property <[Radio]> radios;
    in property <bool> is-web: false;
    in property <[string]> categories: [];
    in-out property <int> radio-cat: 0;
    in-out property <bool> need-more: false;
    in-out property <bool> loading-more: false;
    in-out property <bool> no-more: false;
    // 上一 tick 的滚动偏移（用于判断"用户是否刚滚动过"，Timer 内比较）
    property <length> last-scroll-y: 0px;
    callback category-clicked(int);
    callback open-radio(int);
    callback navigate(int);

    // 内容区宽度（AppWindow 传入），响应式列数 3~5
    in property <length> page-w: 900px;
    property <int> grid-columns: Math.max(3, Math.min(6, Math.floor((page-w - 52px) / 172px)));
    property <length> grid-card-w: (page-w - 52px - 16px * (grid-columns - 1)) / grid-columns;

    background: transparent;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 12px;
        padding-top: 8px;

        // ---- 标题区（随分类变更）----
        VerticalLayout {
            spacing: 3px;
            padding-left: 26px;
            padding-right: 26px;

            Text {
                text: root.categories.length > 0 && root.radio-cat < root.categories.length
                    ? root.categories[root.radio-cat] : Language.page-all-radio;
                color: Theme.palette.text;
                font-size: 22px;
                font-weight: 700;
            }
            Text {
                text: Language.page-sub-radio;
                color: Theme.palette.text-faint;
                font-size: 13px;
            }
        }

        // ---- 电台分类 Tab（复用通用 TabBar）----
        HorizontalLayout {
            padding-left: 26px;
            padding-right: 26px;
            height: 36px;

            TabBar {
                width: 100%;
                items: root.categories;
                current <=> root.radio-cat;
                selected(idx) => { root.category-clicked(idx); }
            }
        }

        // ---- 电台响应式网格滚动区（触底分页加载）----
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            clip: true;

            sv := ScrollView {
                width: 100%;
                height: 100%;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: always-off;

                VerticalLayout {
                    spacing: 16px;
                    padding-left: 26px;
                    padding-right: 26px;
                    padding-bottom: 20px;

                    Rectangle {
                        height: Math.max(0px, Math.ceil(root.radios.length * 1.0 / root.grid-columns) * 192px - 16px);
                        for rd[i] in root.radios: MediaCard {
                            x: Math.mod(i, root.grid-columns) * (root.grid-card-w + 16px);
                            y: Math.floor(i / root.grid-columns) * 192px;
                            width: root.grid-card-w;
                            height: 176px;
                            badge: rd.plays; title: rd.name; sub: rd.desc;
                            from: rd.from; to: rd.to;
                            cover: rd.cover;
                            clicked => { root.open-radio(rd.id); }
                        }
                    }

                    // 底部提示：加载中 / 没有更多 / 空
                    Text {
                        height: 34px;
                        text: root.loading-more
                            ? Language.loading-tip
                            : root.no-more
                                ? Language.page-no-more
                                : root.radios.length > 0 ? "" : "";
                        color: Theme.palette.text-faint;
                        font-size: 12.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Web 端电台数据待补充：整页空态覆盖网格（desktop 数据正常不受影响）
            if (root.is-web && root.radios.length == 0) : Rectangle {
                background: transparent;
                width: 100%;
                height: 100%;
                PlaceholderPage {
                    x: Math.max(0px, (parent.width - 300px) / 2);
                    y: Math.max(0px, (parent.height - self.height) / 2 - 30px);
                    icon: "📻";
                    title: Language.page-notready-title;
                    desc: Language.page-notready-desc;
                }
            }

            // 自定义竖向滚动条（布局外绝对定位，避免与 sv 形成布局循环）
            Rectangle {
                x: sv.x + sv.width - 14px;
                y: sv.y + 8px;
                width: 10px;
                height: sv.height - 16px;
                CustomScrollBar {
                    viewport-height: sv.visible-height;
                    content-height: sv.content-height;
                    scroll-offset: -sv.content-y;
                    scroll-to(o) => { sv.content-y = -o; }
                }
            }

            // 触底检测（content-y 为负值域，滚动量 = -content-y）+ 内容不足一屏时自动追加
            Timer {
                interval: 150ms;
                triggered => {
                    // 偏移相对上一 tick 变化 = 用户刚滚动过（滚轮/拖动/惯性/滚动条）
                    let moved = -sv.content-y != root.last-scroll-y;
                    root.last-scroll-y = -sv.content-y;
                    if (!root.no-more && !root.loading-more) {
                        if (sv.content-height <= sv.visible-height) {
                            // 内容不足一屏：无条件补页（拉满即停，靠 no-more 兜底）
                            root.need-more = true;
                        } else if (moved && (-sv.content-y) >= sv.content-height - sv.visible-height - 80px) {
                            // 触底只在滚动后判定一次：否则停在底部会每 150ms 重置
                            // need-more，Rust 轮询无限串行拉页（界面卡死）
                            root.need-more = true;
                        }
                    }
                }
            }
        }
    }
}
