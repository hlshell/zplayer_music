// ============================================================================
//  pages/toplist.slint — 排行榜页（已接入主题）
// ============================================================================
import { SectionHeader } from "../../components/cards.slint";
import { PlaceholderPage } from "../placeholder/placeholder.slint";
import { Theme } from "../../theme.slint";
import { Language } from "../../language.slint";

component ToplistRow inherits Rectangle {
    in property <string> rank;       // 排名徽标文字（如 1）
    in property <color> rank-from;
    in property <color> rank-to;
    in property <string> name;
    in property <string> update;     // 更新信息
    in property <string> hot1;
    in property <string> hot2;
    in property <string> hot3;
    callback clicked;

    height: 86px;
    border-radius: 12px;
    background: row-ta.has-hover ? Theme.palette.hover : transparent;

    HorizontalLayout {
        spacing: 16px;
        padding: 12px;
        cross-axis-alignment: center;

        // 排名徽标
        Rectangle {
            width: 62px; height: 62px;
            border-radius: 10px;
            clip: true;
            background: @linear-gradient(135deg, rank-from 0%, rank-to 100%);
            Text {
                text: root.rank;
                color: white; font-size: 22px; font-weight: 800;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }

        VerticalLayout {
            Rectangle { vertical-stretch: 1; }
            Text { text: root.name; color: Theme.palette.text; font-size: 15px; font-weight: 600; }
            Text { text: root.update; color: Theme.palette.text-faint; font-size: 11px; }
            Rectangle { vertical-stretch: 1; }
        }

        Rectangle { horizontal-stretch: 1; }

        // 热门歌预览
        VerticalLayout {
            Rectangle { vertical-stretch: 1; }
            for txt in [root.hot1, root.hot2, root.hot3]: Text {
                text: txt;
                color: Theme.palette.text-secondary; font-size: 12px;
                overflow: elide;
            }
            Rectangle { vertical-stretch: 1; }
        }

        // 进入箭头
        Rectangle { width: 36px; height: 36px;
            Image {
                source: @image-url("../../assets/icons/arrow-more-faint.svg");
                width: 18px; height: 18px;
                horizontal-alignment: center; vertical-alignment: center;
                colorize: Theme.palette.text-faint;
            }
        }
    }

    row-ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

export component ToplistPage inherits VerticalLayout {
    in property <bool> is-web: false;
    callback open-toplist(int);
    callback navigate(int);

    spacing: 18px;
    padding-top: 8px;
    padding-bottom: 20px;
    padding-left: 26px;
    padding-right: 26px;

    // Web 端暂无榜单接口：显示待补充空态（desktop 保持原榜单）
    if (root.is-web) : PlaceholderPage {
        icon: "🏆";
        title: Language.page-notready-title;
        desc: Language.page-notready-desc;
    }
    if (!root.is-web) : VerticalLayout {
        SectionHeader { title: Language.toplist-official; }
    VerticalLayout { spacing: 10px;
        ToplistRow { rank: "1"; rank-from: #ef4444; rank-to: #f97316; name: Language.toplist-name-1; update: Language.toplist-update-live; hot1: "1. 歌曲A"; hot2: "2. 歌曲B"; hot3: "3. 歌曲C"; clicked => { root.open-toplist(0); } }
        ToplistRow { rank: "2"; rank-from: #6c5ce7; rank-to: #0fb9d4; name: Language.toplist-name-2; update: Language.toplist-update-daily; hot1: "1. 歌曲D"; hot2: "2. 歌曲E"; hot3: "3. 歌曲F"; clicked => { root.open-toplist(1); } }
        ToplistRow { rank: "3"; rank-from: #f59e0b; rank-to: #ef4444; name: Language.toplist-name-3; update: Language.toplist-update-daily; hot1: "1. 歌曲G"; hot2: "2. 歌曲H"; hot3: "3. 歌曲I"; clicked => { root.open-toplist(2); } }
        ToplistRow { rank: "4"; rank-from: #22c55e; rank-to: #14b8a6; name: Language.toplist-name-4; update: Language.toplist-update-weekly; hot1: "1. 歌曲J"; hot2: "2. 歌曲K"; hot3: "3. 歌曲L"; clicked => { root.open-toplist(3); } }
    }

        SectionHeader { title: Language.toplist-global; }
        VerticalLayout { spacing: 10px;
            ToplistRow { rank: "5"; rank-from: #0ea5e9; rank-to: #6366f1; name: Language.toplist-name-5; update: Language.toplist-update-daily; hot1: "1. 歌曲M"; hot2: "2. 歌曲N"; hot3: "3. 歌曲O"; clicked => { root.open-toplist(4); } }
            ToplistRow { rank: "6"; rank-from: #ec4899; rank-to: #a78bfa; name: Language.toplist-name-6; update: Language.toplist-update-daily; hot1: "1. 歌曲P"; hot2: "2. 歌曲Q"; hot3: "3. 歌曲R"; clicked => { root.open-toplist(5); } }
        }
    }
}
