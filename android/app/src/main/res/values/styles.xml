<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 公共基础主题：深色全屏 + 启动背景（无启动器区域时也能覆盖到首帧） -->
    <style name="AppTheme.Base" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:colorBackground">@color/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Android 11 及以下：沿用 preview window（windowBackground）作为启动画面 -->
    <style name="AppTheme" parent="AppTheme.Base" />
</resources>
